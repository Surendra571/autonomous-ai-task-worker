# Application Configuration
APP_ENV=development
LOG_LEVEL=INFO
PORT=8000
HOST=0.0.0.0

# Database Configuration (PostgreSQL AsyncPG)
# For local Docker Compose: postgresql+asyncpg://postgres:postgres@postgres:5432/task_worker
# For local host testing without docker: postgresql+asyncpg://postgres:postgres@localhost:5432/task_worker
# For standalone local without running postgres service: sqlite+aiosqlite:///./data/task_worker.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/task_worker

# OpenAI-Compatible LLM Interface
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Tool and File Paths
INBOX_DIR=./data/invoices
ARTIFACTS_DIR=./data/artifacts

# Browser Automation
BROWSER_HEADLESS=true
PLAYWRIGHT_BROWSERS_PATH=./.playwright-browsers

# Finance Application Deterministic Test Credentials
FINANCE_APP_USERNAME=finance_admin
FINANCE_APP_PASSWORD=password123
FINANCE_APP_SECRET_KEY=finance-secret-key-autonomous-worker-2024
